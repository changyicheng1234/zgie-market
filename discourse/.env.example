# Pin the same image used by the current upstream Discourse devcontainer.
DISCOURSE_DEV_IMAGE=docker.io/discourse/discourse_dev:20260803-0122
DISCOURSE_UPSTREAM_BRANCH=main

# Host ports for the local experiment.
DISCOURSE_HTTP_PORT=4200
DISCOURSE_MAIL_PORT=8025
ZGIE_EXTERNAL_HOSTNAME=localhost
ZGIE_EXTERNAL_PORT=4200

# Initial site identity.
ZGIE_SITE_TITLE="智工集市"
ZGIE_SITE_DESCRIPTION="智能工程学院师生的邀请制交流社区"
ZGIE_DEFAULT_LOCALE=zh_CN
ZGIE_LOGIN_REQUIRED=true

# global_code: signup form asks for this code.
# invite_links: only individual/shareable Discourse invite links can create users.
ZGIE_REGISTRATION_MODE=global_code
ZGIE_INVITE_CODE=dev-only-change-me

# 企业微信群机器人 webhook（可选）。留空则跳过新主题通知。
ZGIE_WECOM_WEBHOOK_URL=

# Local rendering/demo data. Never reuse this password outside development.
ZGIE_DEMO_EMAIL=demo@example.com
ZGIE_DEMO_USERNAME=zgiedemo
ZGIE_DEMO_PASSWORD="VioletRiver!8246-Campus"
ZGIE_DEMO_PEER_EMAIL=demo-peer@example.com
ZGIE_DEMO_PEER_USERNAME=zgiepeer
ZGIE_DEMO_PEER_PASSWORD="CedarBridge!3902-Peer"
